# Copia este archivo como .env y completa tus datos reales.
# NUNCA subas el archivo .env a GitHub.

# Puerto donde corre la API
PORT=3000

# Cadena de conexión de MongoDB Atlas (sin nombre de base de datos al final)
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Nombre de la base de datos (se pasa con la opción dbName)
DB_NAME=taskflow

# Tamaño máximo del pool de conexiones
MAX_POOL_SIZE=10

# development muestra más detalle en errores 500; production lo oculta
NODE_ENV=development
